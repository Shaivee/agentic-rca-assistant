# Copy to .env and fill in. .env is git-ignored - never commit real keys.
GROQ_API_KEY=
# Optional overrides:
# LLM_PROVIDER=groq            # or openai
# LLM_MODEL=openai/gpt-oss-120b     # Groq free tier; also openai/gpt-oss-20b, qwen/qwen3.6-27b
# LLM_REASONING_EFFORT=low          # gpt-oss only: low | medium | high
# OPENAI_API_KEY=
# EMBEDDINGS=fastembed         # or openai, or none (BM25 only)
